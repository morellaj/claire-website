---
// Claire's colouring page. Deliberately not linked from the rest of the site
// for now. The app itself is plain JS in public/paint/js/ (no build step);
// the pictures are static JSON in public/paint/pictures/, made by
// ../tools/convert.mjs (which lives outside site/ and is never published).
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>claire's colouring ♡</title>
    <link rel="manifest" href="/paint/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/paint/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/paint/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="colouring" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#FFD9EC" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pacifico&family=Fredoka:wght@500;600;700&family=Quicksand:wght@500;600&display=swap" />
    <style is:global>
      :root {
        --pink-bg: #FFD9EC;
        --pink-bubble: #FFB6D9;
        --pink-accent: #FF4FA3;
        --cream: #FFF8F3;
        --ink: #3B1F33;
        --lavender: #D6B8FF;
        --bar: 58px;
        --chip: 54px;
      }
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      html, body { margin: 0; height: 100%; }
      body {
        font-family: "Quicksand", -apple-system, sans-serif; font-weight: 600; color: var(--ink);
        background: linear-gradient(180deg, var(--pink-bg) 0%, #FFC4DE 100%) fixed;
        -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
        overscroll-behavior: none;
      }
      button, a { touch-action: manipulation; font: inherit; color: inherit; }
      button { cursor: pointer; }
      h1, h2 { font-family: "Fredoka", sans-serif; color: var(--pink-accent); }
      [hidden] { display: none !important; }

      /* ------------------------------------------------------------ gallery */
      body:not([data-view="gallery"]) #gallery { display: none; }
      body:not([data-view="colour"]) #colour { display: none; }
      body:not([data-view="make"]) #make { display: none; }
      #gallery { max-width: 1100px; margin: 0 auto; padding: calc(16px + env(safe-area-inset-top)) 20px 60px; }
      .g-head { display: flex; align-items: center; gap: 14px; }
      .g-head h1 { font-family: "Pacifico", cursive; font-weight: 400; font-size: 2.1rem; margin: 6px 0 10px; text-shadow: 2px 2px 0 #fff; }
      .g-head img { width: 64px; height: auto; }
      #tip {
        display: flex; gap: 10px; align-items: center; background: #fff8; border: 2px dashed var(--pink-accent);
        border-radius: 16px; padding: 10px 14px; margin: 4px 0 14px; font-size: 0.95rem;
      }
      #tip button { margin-left: auto; border: 0; background: var(--pink-bubble); border-radius: 999px; padding: 6px 12px; }
      .shelf h2 { margin: 18px 0 10px; font-size: 1.35rem; scroll-margin-top: 12px; }
      .shelf { scroll-margin-top: 12px; }
      .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 6px; }
      .jump button {
        border: 0; border-radius: 999px; padding: 8px 14px; background: #fff; font-family: "Fredoka", sans-serif;
        box-shadow: 0 3px 0 var(--pink-bubble); font-size: 0.95rem;
      }
      .jump button:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--pink-bubble); }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
      .card {
        display: block; text-decoration: none; background: #fff; border-radius: 20px; padding: 10px;
        box-shadow: 0 4px 0 var(--pink-bubble), 0 6px 18px #ff4fa322; transition: transform .12s;
      }
      .card:active { transform: scale(0.96); }
      .thumb-wrap {
        position: relative; aspect-ratio: 1; display: grid; place-items: center;
        background: var(--cream); border-radius: 14px; overflow: hidden;
      }
      .thumb { max-width: 92%; max-height: 92%; image-rendering: pixelated; }
      .badge {
        position: absolute; top: 6px; right: 6px; background: var(--pink-accent); color: #fff;
        border-radius: 999px; padding: 2px 9px; font-size: 0.8rem; font-family: "Fredoka", sans-serif;
      }
      .badge.done { background: #3fbf7f; }
      .card-name { font-family: "Fredoka", sans-serif; margin-top: 8px; font-size: 1.02rem; color: var(--ink); }
      .card-meta { font-size: 0.78rem; opacity: 0.6; }
      .loading { opacity: .7; }
      .make-btn {
        display: inline-block; margin: 2px 0 12px; padding: 12px 20px; border-radius: 18px; text-decoration: none;
        background: var(--pink-accent); color: #fff; font-family: "Fredoka", sans-serif; font-size: 1.1rem;
        box-shadow: 0 4px 0 #c4307a;
      }
      .make-btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #c4307a; }
      .del {
        position: absolute; top: 6px; left: 6px; width: 30px; height: 30px; border-radius: 50%; border: 0;
        background: #fff; box-shadow: 0 1px 4px #3b1f3344; font-size: 1.1rem; line-height: 1; padding: 0;
      }

      /* ------------------------------------------------------------ make from a photo */
      #make { max-width: 1100px; margin: 0 auto; padding: calc(12px + env(safe-area-inset-top)) 16px 30px; }
      .make-head { display: flex; align-items: center; gap: 12px; }
      .make-head h1 { font-size: 1.6rem; margin: 4px 0; }
      .pick {
        display: grid; place-items: center; gap: 10px; text-align: center; margin: 30px auto; max-width: 520px;
        background: #fff; border-radius: 26px; padding: 40px 20px; box-shadow: 0 6px 0 var(--pink-bubble);
      }
      .pick label { cursor: pointer; }
      .pick .big { font-size: 3.5rem; }
      .pick p { margin: 0; opacity: .75; }
      #make-file { display: none; }
      .make-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 10px; }
      @media (max-aspect-ratio: 1/1) { .make-grid { grid-template-columns: 1fr; } }
      .panel { background: #fff; border-radius: 22px; padding: 12px; box-shadow: 0 4px 0 var(--pink-bubble); }
      .panel h2 { font-size: 1.05rem; margin: 2px 4px 8px; }
      .crop-box { position: relative; height: min(56vh, 520px); }
      #make-crop { position: absolute; inset: 0; touch-action: none; }
      .preview-box { display: grid; place-items: center; height: min(40vh, 380px); background: var(--cream); border-radius: 14px; }
      #make-preview { max-width: 96%; max-height: 96%; image-rendering: pixelated; }
      .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 10px 4px; }
      .pill { border: 2px solid var(--pink-bubble); background: #fff; border-radius: 999px; padding: 6px 14px; font-family: "Fredoka", sans-serif; }
      .pill.on { background: var(--pink-accent); border-color: var(--pink-accent); color: #fff; }
      #make-colors { flex: 1; min-width: 160px; accent-color: var(--pink-accent); }
      #make-name { flex: 1; min-width: 160px; font: inherit; padding: 10px 12px; border-radius: 14px; border: 2px solid var(--pink-bubble); }
      #make-start { background: var(--pink-accent); color: #fff; box-shadow: 0 3px 0 #c4307a; padding: 0 18px; font-size: 1.05rem; }
      #make-start:disabled { opacity: .5; }
      .small { font-size: .85rem; opacity: .7; margin: 4px; }

      /* ------------------------------------------------------------ colouring */
      #colour {
        position: fixed; inset: 0; display: grid;
        grid-template-rows: calc(var(--bar) + env(safe-area-inset-top)) 1fr auto;
        grid-template-columns: 1fr;
        grid-template-areas: "bar" "stage" "palette";
      }
      .bar {
        grid-area: bar; display: flex; align-items: center; gap: 6px; padding: env(safe-area-inset-top) 10px 0;
        background: rgba(255, 217, 236, 0.92); border-bottom: 2px dashed var(--pink-accent);
      }
      .bar .name { font-family: "Fredoka", sans-serif; font-size: 1.15rem; color: var(--pink-accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
      .bar .pct { font-family: "Fredoka", sans-serif; background: #fff; border-radius: 999px; padding: 2px 10px; font-size: 0.95rem; }
      .bar .spacer { flex: 1; }
      .btn {
        min-width: 44px; height: 44px; border: 0; border-radius: 14px; background: #fff;
        box-shadow: 0 3px 0 var(--pink-bubble); font-size: 1.25rem; padding: 0 10px; display: inline-grid; place-items: center;
      }
      .btn:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--pink-bubble); }
      .btn:disabled { opacity: 0.35; }
      .btn.text { font-size: 0.95rem; font-family: "Fredoka", sans-serif; text-decoration: none; }
      .stage { grid-area: stage; position: relative; overflow: hidden; }
      #board { position: absolute; inset: 0; touch-action: none; display: block; }
      .zoom { position: absolute; left: 10px; bottom: 10px; display: flex; flex-direction: column; gap: 8px; }

      #palette {
        grid-area: palette; display: grid; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
        grid-template-columns: repeat(auto-fill, var(--chip)); justify-content: center;
        max-height: calc(var(--chip) * 3 + 46px); overflow-y: auto;
        background: rgba(255, 248, 243, 0.85); border-top: 2px dashed var(--pink-accent);
      }
      .chip {
        position: relative; width: var(--chip); height: var(--chip); border-radius: 50%;
        border: 3px solid #fff; background: var(--c); box-shadow: 0 2px 6px #3b1f3333;
        display: grid; place-items: center; padding: 0; transition: transform .12s;
      }
      .chip .num { font-family: "Fredoka", sans-serif; font-size: 1.2rem; color: var(--ink); text-shadow: 0 0 3px #fff, 0 0 6px #fff; }
      .chip.dark .num { color: #fff; text-shadow: 0 0 3px #000a; }
      .chip .left {
        position: absolute; bottom: -6px; right: -8px; background: #fff; border-radius: 999px; font-size: 0.68rem;
        padding: 0 5px; min-width: 20px; text-align: center; box-shadow: 0 1px 3px #3b1f3333;
      }
      .chip.on { transform: scale(1.14); border-color: var(--pink-accent); box-shadow: 0 0 0 3px #fff, 0 0 0 6px var(--pink-accent); }
      .chip.finished { opacity: 0.55; }
      .chip.finished .left { background: #3fbf7f; color: #fff; }
      .chip.nudge { animation: nudge .45s; }
      @keyframes nudge { 0%,100% { transform: none; } 25% { transform: translateX(-5px) rotate(-6deg); } 75% { transform: translateX(5px) rotate(6deg); } }

      /* iPad landscape: palette down the right-hand side */
      @media (min-aspect-ratio: 1/1) {
        #colour {
          grid-template-rows: calc(var(--bar) + env(safe-area-inset-top)) 1fr;
          grid-template-columns: 1fr auto;
          grid-template-areas: "bar bar" "stage palette";
        }
        #palette {
          max-height: none; height: 100%; grid-auto-flow: column;
          grid-template-rows: repeat(var(--rows, 10), var(--chip));
          grid-template-columns: repeat(var(--cols, 1), var(--chip)); align-content: start; justify-content: start;
          padding: 14px calc(14px + env(safe-area-inset-right)) 14px 14px; gap: 10px;
          border-top: 0; border-left: 2px dashed var(--pink-accent); overflow: auto;
        }
      }

      /* ------------------------------------------------------------ finished */
      #finish {
        position: fixed; inset: 0; display: grid; place-items: center; background: #ffd9ecaa; z-index: 20;
        backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
      }
      .finish-card {
        background: #fff; border-radius: 28px; padding: 20px 26px 24px; text-align: center; width: min(420px, 90vw);
        box-shadow: 0 6px 0 var(--pink-bubble), 0 10px 40px #ff4fa355; position: relative; animation: popin .45s cubic-bezier(.2,1.6,.5,1);
      }
      @keyframes popin { from { transform: scale(.4); opacity: 0; } }
      .finish-card h2 { margin: 6px 0 4px; font-size: 1.8rem; }
      .finish-card p { margin: 0 0 12px; }
      #finish-thumb { width: 220px; max-width: 70%; image-rendering: pixelated; border-radius: 10px; }
      .finish-card .pusheen { position: absolute; width: 110px; top: -70px; right: -20px; }
      .finish-buttons { display: flex; gap: 10px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }
      #sizes {
        position: fixed; inset: 0; display: grid; place-items: center; background: #ffd9ecaa; z-index: 15;
        backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
      }
      .sizes-card {
        background: #fff; border-radius: 28px; padding: 18px 22px 20px; width: min(420px, 90vw); text-align: center;
        box-shadow: 0 6px 0 var(--pink-bubble), 0 10px 40px #ff4fa355; animation: popin .3s cubic-bezier(.2,1.6,.5,1);
      }
      .sizes-card h2 { margin: 4px 0 0; font-size: 1.5rem; }
      .sizes-card p { margin: 2px 0 12px; opacity: .7; }
      #sizes-list { display: grid; gap: 10px; margin-bottom: 14px; }
      .size-btn {
        display: grid; grid-template-columns: auto auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: center;
        text-align: left; text-decoration: none; color: var(--ink); background: var(--cream); border-radius: 18px; padding: 12px 16px;
        box-shadow: 0 3px 0 var(--pink-bubble); font-family: "Fredoka", sans-serif;
      }
      .size-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--pink-bubble); }
      .size-btn b { font-size: 1.2rem; }
      .size-info { font-size: .8rem; opacity: .65; grid-column: 2 / 4; }
      .size-note { grid-row: 1; grid-column: 3; justify-self: end; font-size: .85rem; color: var(--pink-accent); }
      .size-dot { grid-row: 1 / 3; border-radius: 50%; background: var(--pink-accent); }
      .size-dot.little { width: 16px; height: 16px; }
      .size-dot.medium { width: 24px; height: 24px; }
      .size-dot.big { width: 32px; height: 32px; }
      .fun-layer { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 30; }
    </style>
  </head>
  <body data-view="gallery">
    <main id="gallery">
      <div class="g-head">
        <img src="/images/pusheen-3.gif" alt="" />
        <h1>claire's colouring ♡</h1>
      </div>
      <div id="tip" hidden>
        <span>💡 tip: add this to your Home Screen (share ⬆️ → "Add to Home Screen") so your pictures never get lost!</span>
        <button id="tip-close">ok!</button>
      </div>
      <div id="gallery-list"></div>
    </main>

    <div id="make">
      <div class="make-head">
        <a class="btn text" href="#/">‹ pictures</a>
        <h1>make a picture 📷</h1>
      </div>
      <div id="make-step1" class="pick">
        <label class="btn text" for="make-file"><span class="big">🖼️</span></label>
        <label class="make-btn" for="make-file">choose a photo</label>
        <p>pick any photo and turn it into a colour-by-number!</p>
        <p class="small">your photo stays on this iPad. it isn't sent anywhere.</p>
        <p id="make-status"></p>
        <input id="make-file" type="file" accept="image/*" />
      </div>
      <div id="make-step2" hidden>
        <div class="make-grid">
          <div class="panel">
            <h2>1. drag the box around the part you want</h2>
            <div class="crop-box"><canvas id="make-crop"></canvas></div>
            <div class="row"><label class="btn text" for="make-file">pick a different photo</label></div>
          </div>
          <div class="panel">
            <h2>2. how big and how many colours?</h2>
            <div class="preview-box"><canvas id="make-preview"></canvas></div>
            <p class="small" id="make-info"></p>
            <div class="row"><span>size</span><span id="make-sizes" class="row" style="margin:0"></span></div>
            <div class="row"><span>colours</span><input id="make-colors" type="range" min="8" max="30" value="20" /><b id="make-colors-n">20</b></div>
            <div class="row"><input id="make-name" maxlength="40" placeholder="name it! (my picture)" /></div>
            <div class="row"><button class="btn text" id="make-start" disabled>start colouring! ✨</button></div>
          </div>
        </div>
      </div>
    </div>

    <div id="colour">
      <div class="bar">
        <a class="btn text" href="#/">‹ pictures</a>
        <span class="name" id="pic-name"></span>
        <span class="pct" id="pct">0%</span>
        <span class="spacer"></span>
        <button class="btn" id="undo" aria-label="undo" title="undo">↶</button>
        <button class="btn" id="redo" aria-label="redo" title="redo">↷</button>
        <button class="btn" id="mute" aria-label="sound on or off" title="sound">🔊</button>
        <button class="btn" id="find" aria-label="find what's left" title="find what's left">🔍</button>
        <button class="btn" id="save" aria-label="save to photos" title="save to photos">📸</button>
      </div>
      <div class="stage">
        <canvas id="board"></canvas>
        <div class="zoom">
          <button class="btn" id="zoom-in" aria-label="zoom in">＋</button>
          <button class="btn" id="zoom-out" aria-label="zoom out">－</button>
          <button class="btn" id="fit" aria-label="see the whole picture">⤢</button>
        </div>
      </div>
      <nav id="palette"></nav>
    </div>

    <div id="sizes" hidden>
      <div class="sizes-card">
        <h2 id="sizes-name"></h2>
        <p>which size?</p>
        <div id="sizes-list"></div>
        <button class="btn text" id="sizes-close">never mind</button>
      </div>
    </div>

    <div id="finish" hidden>
      <div class="finish-card">
        <img class="pusheen" src="/images/pusheen-4.gif" alt="" />
        <h2>you did it!! 🎉</h2>
        <p id="finish-name"></p>
        <canvas id="finish-thumb"></canvas>
        <div class="finish-buttons">
          <button class="btn text" id="finish-save">📸 save to photos</button>
          <a class="btn text" href="#/">more pictures ♡</a>
          <button class="btn text" id="finish-close">look at it</button>
        </div>
      </div>
    </div>

    <script is:inline type="module" src="/paint/js/app.js"></script>
  </body>
</html>
